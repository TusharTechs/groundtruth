# ---------------------------------------------------------------------------
# GroundTruth environment. Every value below is optional: with an empty file
# the app runs in DEMO MODE (deterministic mock CALL-E, in-memory store).
# ---------------------------------------------------------------------------

# --- CALL-E mode -----------------------------------------------------------
# true (default) -> deterministic mock CALL-E, UI labeled DEMO MODE.
# false + CALLE_API_KEY -> real calls through @call-e/calle.
MOCK_CALL_E=true

# Server-only. Never exposed to the client. Required for real mode.
# Create one at https://dashboard.heycall-e.com/account/api-keys
# Production keys use the iams_live_ prefix; keep test and live keys separate.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# --- CALL-E Goals (published, version-pinned verification protocol) --------
# When set (and not in mock mode), GroundTruth executes verification through
# client.goals.run against this published Goal instead of composing an ad-hoc
# call task. The Goal's publishedRunSpec.resultSchema is checked against the
# task's hard constraints before dialing; an incompatible Goal is refused.
CALLE_GOAL_ID=

# --- Webhooks (real mode) --------------------------------------------------
# Deliveries are currently unsigned, so the token in the URL is the transport
# auth. Generate your own: openssl rand -hex 32
# No dashboard registration needed — the app passes webhookUrl on each call,
# built from APP_ORIGIN + this token.
WEBHOOK_TOKEN=
APP_ORIGIN=https://your-deployment.example.com

# --- Storage ---------------------------------------------------------------
# PostgreSQL (Neon/Supabase/local). Absent -> in-memory store.
DATABASE_URL=

# --- Optional goal analyzer upgrade ----------------------------------------
# OpenAI-compatible endpoint. Fails closed to the deterministic heuristic.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Safety ----------------------------------------------------------------
REDACT_PII=true
